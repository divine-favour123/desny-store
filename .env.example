# Copy this file to .env.local for local development.
# For Vercel: add these same variables under
# Project Settings -> Environment Variables (Production, Preview, Development).

# Supabase project URL and anon/public key
# Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Paystack public key (test or live)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
